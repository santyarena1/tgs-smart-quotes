# Build de producción de la extensión (Railway).
# La extensión le pega al dominio del WEB (no al de la API directa) porque la cookie de sesión
# vive en el dominio del web: al loguearte, el proxy /api del web setea la cookie ahí. Pegándole
# al web + /api, la cookie viaja y la sesión de la extensión funciona.
VITE_API_BASE=https://web-production-9cbbd.up.railway.app/api
VITE_WEB_APP_URL=https://web-production-9cbbd.up.railway.app
