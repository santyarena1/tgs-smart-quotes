generator client {
  provider      = "prisma-client-js"
  // "native" para dev local; "debian-openssl-3.0.x" para la imagen de producción (Debian Bookworm).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteState {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
  REEMPLAZADO
  NO_CONCRETADO
}

enum TaxCondition {
  CONSUMIDOR_FINAL
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
}

enum RequestState {
  PENDIENTE
  EN_PREPARACION
  LISTA
  ENVIADA
  CERRADA
}

enum PdfKind {
  SIMPLE
  DETALLADO
}

enum PcConcept {
  CPU
  MOTHERBOARD
  GPU
  OTHER
}

enum FieldOverride {
  HEREDAR
  MOSTRAR
  OCULTAR
}

enum SendAttemptStatus {
  PENDIENTE
  CONFIRMADO_AUTO
  CONFIRMADO_MANUAL
  NO_ENVIADO
  AMBIGUO
}

enum AiTaskType {
  REQUEST_ANALYSIS
  COMPATIBILITY
  RESPONSE_SUGGESTION
  SEMANTIC_SIMILARITY
  CHATBOT_RESPONSE
  QUOTE_ENRICHMENT
}

enum ProcessingStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  FAILED
}

enum Model3DStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum Model3DSource {
  UPLOAD
  TRIPO
  SKETCHFAB
}

enum AssetOrigin {
  UPLOAD
  SERPER
  OFFICIAL
  PLATFORM
}

enum ChatbotMode {
  OFF
  SUGGEST
  AUTO
}

enum ChatbotMessageDirection {
  INBOUND
  OUTBOUND
}

enum ChatbotMessageStatus {
  OBSERVED
  GENERATED
  SUGGESTED
  SEND_PENDING
  SENT
  SEND_FAILED
  DISMISSED
  ESCALATED
}

enum ChatbotMessageActor {
  CUSTOMER
  BOT
  HUMAN
  SYSTEM
}

enum ChatbotMessageChannel {
  EXTENSION
  CLOUD_API
}

enum SuggestionTone {
  AMIGABLE
  INTERMEDIO
  TECNICO
}

enum UserRole {
  ADMIN
  VENDEDOR
}

enum MovementKind {
  SALARY_ACCRUAL
  SALARY_PAYMENT
  ADVANCE
  MERCHANDISE
  CARD_CONSUMPTION
  DEBT
  REPAYMENT
  REIMBURSEMENT
  INSTALLMENT
  ADJUSTMENT
}

enum MovementDirection {
  EMPLOYEE_OWES
  COMPANY_OWES
}

enum MovementStatus {
  PENDING
  APPLIED
  CANCELLED
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  MERCADO_PAGO
  TARJETA
  OTRO
}

enum ObligationKind {
  MERCHANDISE
  CARD_CONSUMPTION
  ADVANCE
  OTHER
}

enum ObligationStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum AllocationTarget {
  OBLIGATION
  INSTALLMENT
  PERIOD
  GENERAL
}

enum RequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PeriodStatus {
  DRAFT
  CONFIRMED
}

enum StatusEventType {
  SOLICITUD_CREADA
  SOLICITUD_ASIGNADA
  SOLICITUD_LISTA
  ANALISIS_IA
  PRESUPUESTO_CREADO
  VERSION_CREADA
  PRECIOS_ACTUALIZADOS
  PDF_GENERADO
  MENSAJE_PREPARADO
  ENVIO_DETECTADO
  ENVIO_CONFIRMADO_MANUAL
  ENVIO_DESCARTADO
  ACEPTACION
  RECHAZO
  REEMPLAZO
  NO_CONCRETADO
  REACTIVADO
  REVISION_REQUERIDA
  INTENCION_DETECTADA
  SUGERENCIA_IA
  COMPATIBILIDAD_IA
  CAMBIO_ESTADO
  CLIENTE_CREADO
  PRODUCTO_MODIFICADO
  COLECCION_MODIFICADA
  COSTO_AJUSTADO
  TOTAL_AJUSTADO
  VERSION_RESTAURADA
}

/// Intención detectada en la respuesta del cliente. Nunca muta estado sin confirmación humana.
enum ReplyIntent {
  ACEPTA
  RECHAZA
  PIDE_CAMBIO
  CONSULTA
  AMBIGUA
}

model User {
  id            String                @id @default(uuid())
  username      String                @unique
  passwordHash  String
  displayName   String?
  role          UserRole              @default(VENDEDOR)
  branchId      String?
  branch        Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  lastAccessAt  DateTime?
  navPrefsJson  Json?
  sessions      Session[]
  products      Product[]
  combos        Combo[]
  versions      QuoteVersion[]
  audits        AuditLog[]
  priceChanges  ProductPriceHistory[]
  sendAttempts  QuoteSendAttempt[]
  deliveries    QuoteDelivery[]
  notifications Notification[]
  events        QuoteStatusEvent[]
  requests      QuoteRequest[]        @relation("RequestCreator")
  assignments   QuoteRequest[]        @relation("RequestAssignee")

  employeesCreated         Employee[]        @relation("EmployeeCreatedBy")
  employee                 Employee?         @relation("EmployeeUser")
  salaryRecordsCreated     SalaryRecord[]    @relation("SalaryRecordCreatedBy")
  movementsCreated         Movement[]        @relation("MovementCreatedBy")
  movementsApplied         Movement[]        @relation("MovementAppliedBy")
  movementsCancelled       Movement[]        @relation("MovementCancelledBy")
  obligationsCreated       Obligation[]      @relation("ObligationCreatedBy")
  paymentsCreated          Payment[]         @relation("PaymentCreatedBy")
  employeeRequestsCreated  EmployeeRequest[] @relation("EmployeeRequestCreatedBy")
  employeeRequestsReviewed EmployeeRequest[] @relation("EmployeeRequestReviewedBy")
  employeePeriodsConfirmed EmployeePeriod[]  @relation("EmployeePeriodConfirmedBy")

  @@index([branchId])
  @@index([role, active])
}

model Branch {
  id        String     @id @default(uuid())
  name      String     @unique
  address   String?
  phones    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  employees Employee[]
  quoteFamilies QuoteFamily[]
  quotePdfs QuotePdf[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  renewedAt DateTime @default(now())
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId, expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  username  String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model Product {
  id                String                @id @default(uuid())
  name              String
  normalizedName    String
  costCents         BigInt
  salePriceCents    BigInt
  markupBps         Int
  usesGeneralMarkup Boolean               @default(true)
  defaultLineId     String?
  defaultLine       PcLine?               @relation(fields: [defaultLineId], references: [id])
  active            Boolean               @default(true)
  /// Descripción reutilizable del componente, se usa como ficha en cualquier
  /// presupuesto que lo incluya (a menos que el ítem tenga su propia observación).
  description       String?
  /// Última vez que el producto se usó en un presupuesto (ítem con productId).
  lastUsedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  updatedById       String
  updatedBy         User                  @relation(fields: [updatedById], references: [id])
  history           ProductPriceHistory[]
  items             QuoteItem[]
  comboItems        ComboItem[]
  assets            ProductAsset[]
  obligations       Obligation[]
  caseModel3D       CaseModel3D?

  @@index([normalizedName])
  @@index([active])
  @@index([lastUsedAt])
}

/// Catálogo externo provisto por AcuStock. No se relaciona con Product ni con presupuestos.
model AcustockProduct {
  mpn            String   @id
  title          String
  description    String
  priceCents     BigInt
  salePriceCents BigInt?
  stockQuantity  Int
  availability   String
  brand          String?
  productType    String?
  imageUrl       String?
  productUrl     String?
  weightKg       Float?
  lengthCm       Float?
  widthCm        Float?
  heightCm       Float?
  tags           String[]
  lastSyncedAt   DateTime

  @@index([title])
  @@index([productType])
  @@index([brand])
  @@index([availability])
  @@index([priceCents])
}

model Combo {
  id             String      @id @default(uuid())
  name           String      @unique
  normalizedName String
  description    String?
  active         Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  updatedById    String
  updatedBy      User        @relation(fields: [updatedById], references: [id])
  items          ComboItem[]

  @@index([normalizedName])
  @@index([active])
}

model ComboItem {
  id        String  @id @default(uuid())
  comboId   String
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  position  Int     @default(0)

  @@unique([comboId, productId])
  @@index([comboId, position])
}

model ProductPriceHistory {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  costCents      BigInt
  salePriceCents BigInt
  markupBps      Int
  reason         String?
  changedById    String
  changedBy      User     @relation(fields: [changedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
}

model PcLine {
  id        String      @id @default(uuid())
  name      String      @unique
  sortOrder Int
  active    Boolean     @default(true)
  aliases   String[]
  keyLine   Boolean     @default(false)
  concept   PcConcept   @default(OTHER)
  products  Product[]
  items     QuoteItem[]
}

model Customer {
  id              String          @id @default(uuid())
  name            String
  normalizedName  String
  phone           String?
  normalizedPhone String?
  dni             String?
  address         String?
  taxCondition    TaxCondition?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  requests        QuoteRequest[]
  families        QuoteFamily[]
  deliveries      QuoteDelivery[]

  @@index([normalizedName])
  @@index([normalizedPhone])
  @@index([dni])
}

model QuoteRequest {
  id                   String                @id @default(uuid())
  title                String
  originalText         String                @default("")
  internalNotes        String                @default("")
  customerId           String?
  customer             Customer?             @relation(fields: [customerId], references: [id])
  detectedPhone        String?
  maximumBudgetCents   BigInt?
  expectedUse          String?
  requiredComponents   String[]
  creatorId            String
  creator              User                  @relation("RequestCreator", fields: [creatorId], references: [id])
  assigneeId           String?
  assignee             User?                 @relation("RequestAssignee", fields: [assigneeId], references: [id])
  state                RequestState          @default(PENDIENTE)
  readyAt              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  families             QuoteFamily[]
  analyses             AiRequest[]
  chatbotConversations ChatbotConversation[]

  @@index([state, createdAt])
  @@index([detectedPhone])
}

model QuoteFamily {
  id                   String                @id @default(uuid())
  visibleNumber        String                @unique
  internalName         String
  requestId            String?
  request              QuoteRequest?         @relation(fields: [requestId], references: [id])
  customerId           String?
  customer             Customer?             @relation(fields: [customerId], references: [id])
  isBuiltPc            Boolean               @default(false)
  activeVersion        Int                   @default(1)
  /// Miniatura de este presupuesto para la ficha web (se manda en cada publish).
  thumbnailUrl         String?
  /// Si está prendido, un cambio de precio en el catálogo que afecte a esta PC
  /// recalcula el presupuesto y, si ya estaba publicada, la re-publica sola.
  autoRepublish        Boolean               @default(false)
  /// Local donde se creó el presupuesto (snapshot fijo, no varía). Es solo informativo para
  /// listado/estadísticas: la impresión usa el local de quien imprime (ver QuotePdf.branchId).
  branchId             String?
  branch               Branch?               @relation(fields: [branchId], references: [id])
  lastActivityAt       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  versions             QuoteVersion[]
  collections          CollectionQuote[]
  events               QuoteStatusEvent[]
  chatbotConversations ChatbotConversation[]

  @@index([internalName])
  @@index([customerId, createdAt])
  @@index([lastActivityAt])
  @@index([branchId])
}

model QuoteVersion {
  id                 String             @id @default(uuid())
  familyId           String
  family             QuoteFamily        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  version            Int
  state              QuoteState         @default(BORRADOR)
  creatorId          String
  creator            User               @relation(fields: [creatorId], references: [id])
  reason             String?
  totalCostCents     BigInt
  totalSaleCents     BigInt
  profitCents        BigInt
  effectiveMarkupBps Int
  publicObservation  String?
  /// Overrides triestado (HEREDAR|MOSTRAR|OCULTAR) elegidos por el operador para esta versión.
  pdfOverrides       Json?
  /// Configuración efectiva congelada al generar el PDF: defaults globales + overrides resueltos.
  resolvedPdfConfig  Json
  financingSnapshot  Json?
  /// Resumen derivado del primer QuoteDelivery confirmado; la fuente de verdad es QuoteSendAttempt/QuoteDelivery.
  sentMessage        String?
  sentAt             DateTime?
  lastActivityAt     DateTime?
  /// Marcado cuando la IA o la extensión detectan un cambio de estado ambiguo que requiere confirmación humana.
  reviewPending      Boolean            @default(false)
  reviewReason       String?
  reactivatedAt      DateTime?
  staleNotifiedAt    DateTime?
  autoClosedAt       DateTime?
  createdAt          DateTime           @default(now())
  items              QuoteItem[]
  pdfs               QuotePdf[]
  attempts           QuoteSendAttempt[]
  deliveries         QuoteDelivery[]
  events             QuoteStatusEvent[]
  replies            QuoteReply[]
  webPublication     WebPublication?
  enrichment         QuoteEnrichment?

  @@unique([familyId, version])
  @@index([state, sentAt])
  @@index([state, lastActivityAt])
  @@index([reviewPending])
}

model QuoteEnrichment {
  id String @id @default(uuid())
  quoteVersionId String @unique
  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  descriptionHtml String?
  powerWatts Int?
  recommendedPsuWatts Int?
  powerNote String?
  gamesJson Json @default("[]")
  programsJson Json @default("[]")
  compatibilityJson Json @default("[]")
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
}

model QuoteItem {
  id                   String       @id @default(uuid())
  versionId            String
  version              QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?     @relation(fields: [productId], references: [id])
  frozenName           String
  lineId               String?
  line                 PcLine?      @relation(fields: [lineId], references: [id])
  quantity             Int
  frozenCostCents      BigInt
  frozenMarkupBps      Int
  frozenSalePriceCents BigInt
  subtotalCents        BigInt
  /// Fecha del precio maestro congelado; permite detectar diferencias contra el catálogo actual.
  masterPriceAt        DateTime?
  masterCostCents      BigInt?
  masterSaleCents      BigInt?
  position             Int
  observation          String?
  /// Ítem principal del PDF SIMPLE cuando la familia es una PC armada.
  isPcMainLine         Boolean      @default(false)

  @@index([productId])
  @@index([versionId, position])
}

model QuotePdf {
  id         String          @id @default(uuid())
  versionId  String
  version    QuoteVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind       PdfKind
  storageKey String
  sha256     String
  sizeBytes  Int
  /// Hash del payload de render: si cambia, el PDF quedó obsoleto y debe regenerarse.
  inputHash  String
  driver     String          @default("local")
  configJson Json?
  /// Local (branch) del usuario que generó/imprimió esta versión del PDF cacheado. El
  /// encabezado (dirección/teléfono) varía según quién imprime, no según quién creó el
  /// presupuesto: si el impresor actual tiene un branch distinto al de este campo, se regenera.
  branchId   String?
  branch     Branch?         @relation(fields: [branchId], references: [id])
  createdAt  DateTime        @default(now())
  deliveries QuoteDelivery[]

  @@unique([versionId, kind])
  @@index([sha256])
}

/// Fuente de verdad del intento de envío asistido por WhatsApp. Nunca autoenvía.
model QuoteSendAttempt {
  id           String            @id @default(uuid())
  versionId    String
  version      QuoteVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chatPhone    String?
  chatName     String?
  message      String
  pdfKind      PdfKind?
  pdfName      String?
  status       SendAttemptStatus @default(PENDIENTE)
  /// Confianza 0-100 de la detección de chat/envío. Baja confianza obliga confirmación humana.
  confidence   Int?
  detectionLog Json?
  internalNote String?
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  createdAt    DateTime          @default(now())
  resolvedAt   DateTime?
  delivery     QuoteDelivery?

  @@index([status, createdAt])
  @@index([versionId, createdAt])
  @@index([chatPhone, createdAt])
}

/// Confirmación del envío: destinatario, PDF, mensaje y fecha. `QuoteVersion.sentAt` es su resumen.
model QuoteDelivery {
  id          String            @id @default(uuid())
  versionId   String
  version     QuoteVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  attemptId   String?           @unique
  attempt     QuoteSendAttempt? @relation(fields: [attemptId], references: [id])
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id])
  chatPhone   String?
  chatName    String?
  message     String?
  pdfKind     PdfKind?
  pdfId       String?
  pdf         QuotePdf?         @relation(fields: [pdfId], references: [id])
  confirmedBy SendAttemptStatus @default(CONFIRMADO_MANUAL)
  deliveredAt DateTime          @default(now())
  userId      String?
  user        User?             @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([versionId, deliveredAt])
  @@index([chatPhone, deliveredAt])
  @@index([customerId, deliveredAt])
}

/// Respuesta recibida del cliente y su intención clasificada. La transición de estado siempre es explícita.
model QuoteReply {
  id           String       @id @default(uuid())
  versionId    String
  version      QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chatPhone    String?
  text         String
  intent       ReplyIntent  @default(AMBIGUA)
  confidence   Int?
  source       String       @default("EXTENSION")
  appliedState QuoteState?
  appliedAt    DateTime?
  createdAt    DateTime     @default(now())

  @@index([versionId, createdAt])
  @@index([intent, createdAt])
}

/// Timeline unificada de presupuesto, versión, solicitud y cliente.
model QuoteStatusEvent {
  id         String          @id @default(uuid())
  type       StatusEventType
  familyId   String?
  family     QuoteFamily?    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  versionId  String?
  version    QuoteVersion?   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestId  String?
  customerId String?
  userId     String?
  user       User?           @relation(fields: [userId], references: [id])
  previous   Json?
  next       Json?
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([familyId, createdAt])
  @@index([versionId, createdAt])
  @@index([requestId, createdAt])
  @@index([customerId, createdAt])
  @@index([type, createdAt])
}

model Collection {
  id                 String            @id @default(uuid())
  name               String            @unique
  normalizedName     String            @default("")
  description        String?
  sortOrder          Int               @default(0)
  icon               String?
  archived           Boolean           @default(false)
  favorite           Boolean           @default(false)
  visibleInExtension Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  quotes             CollectionQuote[]

  @@index([archived, sortOrder])
  @@index([normalizedName])
}

model CollectionQuote {
  collectionId String
  collection   Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  familyId     String
  family       QuoteFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sortOrder    Int         @default(0)
  addedAt      DateTime    @default(now())

  @@id([collectionId, familyId])
  @@index([familyId])
  @@index([collectionId, sortOrder])
}

model FinancingPlan {
  id           String   @id @default(uuid())
  installments Int
  interestBps  Int      @default(0)
  bank         String?
  description  String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum CalculatorGroupKind {
  CASH
  LIST
  PLAN
}

/// Medio de pago de la calculadora de financiación (icono + tasas propias).
model CalculatorGroup {
  id        String              @id @default(uuid())
  key       String              @unique
  label     String
  iconUrl   String?
  iconUrls  String[]            @default([])
  kind      CalculatorGroupKind
  sortOrder Int                 @default(0)
  visible   Boolean             @default(true)
  note      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  plans     CalculatorPlan[]
}

model CalculatorPlan {
  id           String          @id @default(uuid())
  groupId      String
  group        CalculatorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  installments Int
  interestBps  Int             @default(0)
  sortOrder    Int             @default(0)
  visible      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([groupId, sortOrder])
}

model CompanySettings {
  id              String   @id @default("singleton")
  logoUrl         String?
  faviconUrl      String?
  name            String
  taxCondition    String
  cuit            String
  grossIncome     String
  activityStart   String
  address         String
  phones          String
  footerText      String
  rmaUrl          String
  primaryColor    String
  accentColor     String
  listInterestBps Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model PdfSettings {
  id                   String   @id @default("singleton")
  template             String   @default("MODERNO")
  financingBbvaNote    String?
  validityDays         Int?
  showListPrice        Boolean  @default(true)
  showCashTransfer     Boolean  @default(true)
  showFinancing        Boolean  @default(true)
  showBbva             Boolean  @default(true)
  showOtherBanks       Boolean  @default(true)
  showFinancingNote    Boolean  @default(true)
  showTaxData          Boolean  @default(true)
  showServicesBlock    Boolean  @default(true)
  showWindows          Boolean  @default(true)
  showDrivers          Boolean  @default(true)
  showDelay            Boolean  @default(true)
  showRma              Boolean  @default(true)
  showExtraObservation Boolean  @default(false)
  showIndividualPrices Boolean  @default(true)
  showComponentDetail  Boolean  @default(true)
  builtPcTitle         String
  builtPcDescription   String
  assemblyText         String
  installText          String
  windowsText          String
  driversText          String
  estimatedDelay       String
  /// Plantilla del texto de aceptación. `{rmaUrl}` se reemplaza al renderizar.
  rmaText              String   @default("Importante: al aceptar este presupuesto, ya sea mediante compromiso verbal o monetario —seña, abono total, abono parcial o cualquier confirmación de compra/servicio—, el cliente declara conocer y aceptar las Políticas de Servicio Técnico y RMA: {rmaUrl}")
  lineOrder            Json
  /// Overrides visuales del template PDF. Un objeto vacío conserva el diseño histórico.
  layoutJson           Json     @default("{}")
  updatedAt            DateTime @updatedAt
}

model AiSettings {
  id                         String         @id @default("singleton")
  enabled                    Boolean        @default(false)
  model                      String         @default("gpt-4o-mini")
  apiKeyEncrypted            String?
  pcDescriptionPrompt        String?
  productDescriptionPrompt   String?
  analysisEnabled            Boolean        @default(true)
  similarityEnabled          Boolean        @default(true)
  compatibilityEnabled       Boolean        @default(true)
  responsesEnabled           Boolean        @default(true)
  ambiguousSimilarityAi      Boolean        @default(false)
  /// Feedback de compatibilidad al guardar el borrador; si es false solo corre bajo acción explícita.
  compatibilityOnSave        Boolean        @default(false)
  intentEnabled              Boolean        @default(true)
  /// Debajo de esta confianza, la intención detectada exige confirmación humana.
  minIntentConfidence        Int            @default(70)
  defaultTone                SuggestionTone @default(INTERMEDIO)
  monthlyBudgetUsdCents      BigInt?
  generalMarkupBps           Int            @default(3000)
  productSimilarityThreshold Int            @default(70)
  frequentSupportThreshold   Int            @default(3)
  updatedAt                  DateTime       @updatedAt
}

model WhatsappCloudSettings {
  id                   String   @id @default("singleton")
  enabled              Boolean  @default(false)
  phoneNumberId        String?
  businessAccountId    String?
  accessTokenEncrypted String?
  appSecretEncrypted   String?
  webhookVerifyToken   String?
  apiVersion           String   @default("v21.0")
  updatedAt            DateTime @updatedAt
}

/// Configuración operativa y editorial del chatbot. El JSON validado permite ampliar reglas sin redeploy.
model ChatbotSettings {
  id                        String      @id @default("singleton")
  /// Kill-switch autoritativo: si está apagado la API nunca entrega una respuesta auto-enviable.
  enabled                   Boolean     @default(false)
  defaultMode               ChatbotMode @default(SUGGEST)
  /// Override opcional; null hereda `AiSettings.model`.
  model                     String?
  persona                   String
  openingMessages           Json
  closingMessages           Json
  /// Lista unificada `responses[]`; conserva el nombre físico para evitar migrar JSON.
  knowledgeEntries          Json
  escalationKeywords        Json
  escalationInstructions    String
  modelCanEscalate          Boolean     @default(true)
  businessHours             Json
  outsideHoursBehavior      Json
  responseStyle             Json
  multiMessage              Json        @default("{\"enabled\":true,\"splitMode\":\"AI_NATURAL\",\"maxBubbles\":3,\"openingMessage\":\"\",\"closingMessage\":\"\",\"quoteFollowup\":{\"enabled\":true,\"message\":\"Decime si querés cambiar algo o sumar/sacar componentes 👍\"},\"draftMode\":\"QUEUE\",\"betweenDelayMinSeconds\":2,\"betweenDelayMaxSeconds\":6}")
  productMessageIntro       String      @default("Este sería el producto 👇")
  quoteSendPrompt           String      @default("Redactá un mensaje breve y cálido presentando el presupuesto adjunto, respondiendo puntualmente a lo que el cliente pidió según los últimos mensajes. No inventes datos.")
  /// Campo legacy leído durante una versión para fusionar reglas antiguas en `responses[]`.
  customRules               Json
  ignoredAutoMessages       Json        @default("[\"¡Hola! ¿Cómo podemos ayudarte\"]")
  /// Demora aleatoria máxima previa a cada autoenvío; 0 desactiva la espera.
  autoDelayMaxSeconds       Int         @default(0)
  /// Umbral determinístico para reutilizar respuestas históricas y ahorrar tokens.
  reuseSimilarityThreshold  Int         @default(90)
  recontactEnabled          Boolean     @default(false)
  recontactDays             Int         @default(30)
  recontactPrompt           String      @default("")
  recontactMaxAttempts      Int         @default(1)
  scanIntervalSeconds       Int         @default(8)
  maxRecentSnippets         Int         @default(20)
  summaryRefreshEvery       Int         @default(8)
  sendConfirmationTimeoutMs Int         @default(15000)
  updatedAt                 DateTime    @default(now()) @updatedAt
}

/// Memoria compacta, modo y barreras de seguridad por conversación de WhatsApp.
model ChatbotConversation {
  chatKey                String              @id
  displayName            String?
  modeOverride           ChatbotMode?
  summary                String?
  summaryMessageCount    Int                 @default(0)
  escalatedAt            DateTime?
  escalationReason       String?
  activeRequestId        String?
  activeRequest          QuoteRequest?       @relation(fields: [activeRequestId], references: [id], onDelete: SetNull)
  lastQuoteFamilyId      String?
  lastQuoteVersion       Int?
  lastQuoteFamily        QuoteFamily?        @relation(fields: [lastQuoteFamilyId], references: [id], onDelete: SetNull)
  lastInboundFingerprint String?
  lastInboundText        String?
  lastInboundAt          DateTime?
  lastOutboundText       String?
  lastOutboundAt         DateTime?
  recontactCount         Int                 @default(0)
  lastRecontactAt        DateTime?
  recontactOptOut        Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  messages               ChatbotMessageLog[]

  @@index([escalatedAt])
  @@index([updatedAt])
  @@index([activeRequestId])
  @@index([lastQuoteFamilyId])
}

/// Registro inmutable de entradas, decisiones, sugerencias e intentos de envío del chatbot.
model ChatbotMessageLog {
  id                 String                  @id @default(uuid())
  conversationKey    String
  conversation       ChatbotConversation     @relation(fields: [conversationKey], references: [chatKey], onDelete: Cascade)
  direction          ChatbotMessageDirection
  actor              ChatbotMessageActor
  mode               ChatbotMode?
  status             ChatbotMessageStatus
  channel            ChatbotMessageChannel   @default(EXTENSION)
  text               String
  waMessageId        String?
  inboundFingerprint String?
  pairedMessageId    String?
  notificationId     String?
  model              String?
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  inputHash          String?
  shouldEscalate     Boolean                 @default(false)
  escalationReason   String?
  decisionMetadata   Json?
  error              String?
  sentAt             DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([conversationKey, inboundFingerprint, direction])
  @@index([conversationKey, createdAt])
  @@index([status, createdAt])
  @@index([notificationId])
  @@index([inboundFingerprint])
  @@index([waMessageId])
}

/// Parámetros operativos del circuito comercial. Sin vencimiento de presupuestos: solo inactividad.
model OperationsSettings {
  id                     String   @id @default("singleton")
  /// Días sin actividad para que una versión ENVIADO pase a NO_CONCRETADO.
  staleDays              Int      @default(10)
  /// Días antes del cierre automático en los que se notifica al vendedor.
  staleNoticeDays        Int      @default(2)
  autoStaleEnabled       Boolean  @default(true)
  /// Pesos de similitud determinística entre presupuestos (bps sobre 10000).
  similarityCpuBps       Int      @default(3500)
  similarityMotherBps    Int      @default(2000)
  similarityGpuBps       Int      @default(3500)
  similarityOtherBps     Int      @default(1000)
  /// Rango de puntaje considerado ambiguo; solo ahí se consulta IA si está habilitada.
  similarityAmbiguousMin Int      @default(55)
  similarityAmbiguousMax Int      @default(75)
  updatedAt              DateTime @default(now()) @updatedAt
}

/// Interruptor del Módulo Externo (oculto por defecto, se activa con clave).
model ExternalModuleSettings {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
}

/// Configuración de las integraciones externas.
///
/// Photoroom y Cloudflare R2 se eliminaron: el fondo de las imágenes ahora se
/// quita en el propio servidor (sharp) y los archivos se guardan en el disco
/// persistente de Railway, así que ya no hay credenciales que cargar para eso.
model ExternalModuleConfig {
  id                   String   @id @default("singleton")
  tripoKeyEnc          String?
  higgsfieldKeyEnc     String?
  higgsfieldSecretEnc  String?
  serperKeyEnc         String?
  wpHmacSecretEnc      String?
  wpBaseUrl            String   @default("https://www.thegamershop.com.ar")
  autoRepublish        Boolean  @default(true)
  landingLayoutJson    Json?
  updatedAt            DateTime @default(now()) @updatedAt
}

model ProductAsset {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  origin     AssetOrigin
  sourceUrl  String?
  url        String?
  storageKey String?
  isPrimary  Boolean     @default(false)
  approved   Boolean     @default(false)
  status     String      @default("READY")
  /// Motivo del último fallo al quitar el fondo, para poder mostrarlo en la
  /// pantalla en vez de dejar la imagen en "falló" sin explicación.
  lastError  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
}

model CaseModel3D {
  id           String        @id @default(uuid())
  productId    String        @unique
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourcePhotos String[]      @default([])
  glbUrl       String?
  spinUrl      String?
  glbKey       String?
  source       Model3DSource @default(UPLOAD)
  status       Model3DStatus @default(PENDING)
  tripoJobId   String?
  meshStats    Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ThumbnailTemplate {
  id               String   @id @default(uuid())
  name             String
  templateImageUrl String?
  templateKey      String?
  fontsJson        Json     @default("[]")
  rulesJson        Json     @default("{}")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WebPublication {
  id              String            @id @default(uuid())
  quoteVersionId  String            @unique
  quoteVersion    QuoteVersion      @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  status          PublicationStatus @default(DRAFT)
  wpProductId     String?
  url             String?
  thumbnailUrl    String?
  payloadSnapshot Json?
  lastError       String?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ProcessingJob {
  id          String           @id @default(uuid())
  type        String
  status      ProcessingStatus @default(PENDING)
  payload     Json             @default("{}")
  result      Json?
  error       String?
  attempts    Int              @default(0)
  maxAttempts Int              @default(3)
  entityType  String?
  entityId    String?
  runAfter    DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, runAfter])
  @@index([type])
}

model AiRequest {
  id           String        @id @default(uuid())
  task         AiTaskType
  model        String
  inputHash    String
  entityType   String?
  entityId     String?
  requestId    String?
  request      QuoteRequest? @relation(fields: [requestId], references: [id])
  success      Boolean
  error        String?
  durationMs   Int?
  usageJson    Json?
  costUsdCents BigInt        @default(0)
  cacheHit     Boolean       @default(false)
  resultJson   Json?
  createdAt    DateTime      @default(now())

  @@index([task, inputHash])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AiSuggestion {
  id         String          @id @default(uuid())
  entityType String
  entityId   String
  tone       SuggestionTone?
  text       String
  usedText   String?
  usedAt     DateTime?
  model      String
  inputHash  String
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
}

model SimilarityCache {
  id         String @id @default(uuid())
  sourceType String
  sourceId   String
  inputHash  String

  resultJson Json
  createdAt  DateTime @default(now())

  @@unique([sourceType, sourceId, inputHash])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  chatPhone  String?
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  /// Borrador de mensaje sugerido para el vendedor; editable antes de insertar en WhatsApp.
  draft      String?
  metadata   Json?
  readAt     DateTime?
  actedAt    DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([chatPhone, createdAt])
  @@index([entityType, entityId])
  @@index([readAt, createdAt])
}

model Employee {
  id            String            @id @default(uuid())
  fullName      String
  docId         String?
  branchId      String?
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId        String?           @unique
  user          User?             @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  position      String?
  active        Boolean           @default(true)
  notes         String?
  createdById   String
  createdBy     User              @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  salaryRecords SalaryRecord[]
  movements     Movement[]
  obligations   Obligation[]
  payments      Payment[]
  requests      EmployeeRequest[]
  periods       EmployeePeriod[]

  @@index([branchId])
  @@index([userId])
}

model SalaryRecord {
  id                  String   @id @default(uuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amountCents         BigInt
  effectiveFrom       DateTime
  previousAmountCents BigInt?
  changeBps           Int?
  reason              String?
  createdById         String
  createdBy           User     @relation("SalaryRecordCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  movements           Movement[]

  @@index([employeeId, effectiveFrom])
}

model Movement {
  id                String            @id @default(uuid())
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind              MovementKind
  direction         MovementDirection
  amountCents       BigInt
  status            MovementStatus    @default(PENDING)
  occurredAt        DateTime
  description       String?
  obligationId      String?
  obligation        Obligation?       @relation(fields: [obligationId], references: [id])
  installmentId     String?           @unique
  installment       Installment?      @relation(fields: [installmentId], references: [id])
  paymentId         String?
  payment           Payment?          @relation(fields: [paymentId], references: [id])
  requestId         String?
  request           EmployeeRequest?  @relation("MovementRequest", fields: [requestId], references: [id])
  resultingRequests EmployeeRequest[] @relation("RequestResultingMovement")
  salaryRecordId    String?
  salaryRecord      SalaryRecord?     @relation(fields: [salaryRecordId], references: [id])
  createdById       String
  createdBy         User              @relation("MovementCreatedBy", fields: [createdById], references: [id])
  appliedById       String?
  appliedBy         User?             @relation("MovementAppliedBy", fields: [appliedById], references: [id])
  appliedAt         DateTime?
  cancelledById     String?
  cancelledBy       User?             @relation("MovementCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([employeeId, status])
  @@index([employeeId, occurredAt])
}

model Obligation {
  id                  String             @id @default(uuid())
  employeeId          String
  employee            Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind                ObligationKind
  direction           MovementDirection  @default(EMPLOYEE_OWES)
  originalAmountCents BigInt
  description         String?
  productId           String?
  product             Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  status              ObligationStatus @default(OPEN)
  createdById         String
  createdBy           User             @relation("ObligationCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  plan                InstallmentPlan?
  installments        Installment[]
  movements           Movement[]

  @@index([employeeId])
}

model InstallmentPlan {
  id           String     @id @default(uuid())
  obligationId String     @unique
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  count        Int
  firstPeriod  String
  createdAt    DateTime   @default(now())
}

model Installment {
  id           String            @id @default(uuid())
  obligationId String
  obligation   Obligation        @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  number       Int
  amountCents  BigInt
  period       String
  status       InstallmentStatus @default(PENDING)
  paidCents    BigInt            @default(0)
  createdAt    DateTime          @default(now())
  movement     Movement?

  @@unique([obligationId, number])
  @@index([obligationId])
}

model Payment {
  id          String              @id @default(uuid())
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amountCents BigInt
  method      PaymentMethod
  paidAt      DateTime
  reference   String?
  createdById String
  createdBy   User                @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  allocations PaymentAllocation[]
  movements   Movement[]

  @@index([employeeId])
}

model PaymentAllocation {
  id          String           @id @default(uuid())
  paymentId   String
  payment     Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  targetType  AllocationTarget
  targetId    String?
  amountCents BigInt
  createdAt   DateTime         @default(now())

  @@index([paymentId])
}

model EmployeeRequest {
  id                  String        @id @default(uuid())
  employeeId          String
  employee            Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind                MovementKind
  amountCents         BigInt
  description         String?
  status              RequestStatus @default(PENDING_APPROVAL)
  createdByUserId     String
  createdByUser       User          @relation("EmployeeRequestCreatedBy", fields: [createdByUserId], references: [id])
  reviewedById        String?
  reviewedBy          User?         @relation("EmployeeRequestReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  resultingMovementId String?
  resultingMovement   Movement?     @relation("RequestResultingMovement", fields: [resultingMovementId], references: [id])
  movements           Movement[]    @relation("MovementRequest")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([employeeId, status])
}

model EmployeePeriod {
  id              String       @id @default(uuid())
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period          String
  baseSalaryCents BigInt
  linesJson       Json         @default("[]")
  netCents        BigInt
  status          PeriodStatus @default(DRAFT)
  confirmedById   String?
  confirmedBy     User?        @relation("EmployeePeriodConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([employeeId, period])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  action     String
  previous   Json?
  next       Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}
